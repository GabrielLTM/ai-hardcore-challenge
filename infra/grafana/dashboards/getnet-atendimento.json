    {
      "id": 3,
      "type": "stat",
      "title": "Custo estimado (USD)",
      "description": "Soma apenas das chamadas com preço conhecido na tabela versionada. É estimativa, não fatura. Sem dados = custo desconhecido, não zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(getnet_llm_cost_usd_total{service_name=\"getnet-support-api\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
