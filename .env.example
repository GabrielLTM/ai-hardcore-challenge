# Copie para .env na raiz do repositório: cp .env.example .env
# O mesmo arquivo alimenta o Docker Compose (api e worker) e a execução local (backend/ lê ../.env; um backend/.env tem prioridade).
# Nunca versione o .env nem coloque valores reais neste arquivo: .env está no .gitignore.
# Linhas comentadas mostram o valor padrão do código (backend/src/app/bootstrap/settings.py, adapters/inbound/http/run_settings.py, adapters/inbound/knowledge_wiring.py e adapters/outbound/fake/model.py); descomente só o que quiser mudar.
# Mantenha variáveis numéricas opcionais comentadas em vez de vazias: um valor vazio não é número válido.

# --- Aplicação (backend/src/app/bootstrap/settings.py) -----------------------------------------------------
# Perfil: local-demo (identidade fixa, sem login) ou production (exige OIDC_ISSUER e OIDC_AUDIENCE; veja docs/producao.md).
APP_PROFILE=local-demo
# Chave da OpenAI. Sem ela a API sobe, mas POST /chat e /runs respondem 503 provider_not_configured e a ingestão não gera embeddings.
OPENAI_API_KEY=
# Modelo de linguagem usado pelos agentes (Responses API) e pela busca web. Sem preço conhecido, o custo aparece como "não informado".
OPENAI_MODEL=gpt-6-luna
# Modelo de embeddings da ingestão e da consulta (1536 dimensões). Trocar exige reprocessar a base e recriar o índice vetorial.
EMBEDDING_MODEL=text-embedding-3-small
# MongoDB. No Compose o valor é fixado para o serviço mongo; localmente aponta para o Atlas Local publicado em 127.0.0.1:27017.
# MONGO_URI=mongodb://localhost:27017/?directConnection=true
# MONGO_DATABASE=getnet_support
# Identidade do perfil local-demo: único user_id aceito em /chat e /runs, e o workspace dos dados.
# DEMO_USER_ID=cliente1988
# DEMO_WORKSPACE_ID=demo
# Provedor de modelo: openai (padrão) ou fake (modelo enlatado só para testes de carga; recusado no perfil production).
# MODEL_PROVIDER=openai
# Observabilidade: base OTLP/HTTP do coletor (no Compose, http://observability:4318 já vem fixado no serviço api). Sem valor, nada é exportado.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Só com MODEL_PROVIDER=fake (testes de carga, sem rede nem custo): espera antes do primeiro token (ms), pausa entre trechos (ms) e trechos por resposta.
# FAKE_MODEL_FIRST_TOKEN_MS=400
# FAKE_MODEL_DELTA_MS=30
# FAKE_MODEL_DELTAS=40
# Perfil production (veja docs/producao.md): emissor e audiência do token OIDC (obrigatórios; o emissor deve ser https://).
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# Endereço do JWKS (padrão: descoberto em <emissor>/.well-known/openid-configuration; se informado, deve ser https://).
# OIDC_JWKS_URI=
# Algoritmos aceitos, separados por vírgula; somente assimétricos (RS*, PS*, ES*), nunca HS* nem none.
# OIDC_ALGORITHMS=RS256
# Claim do workspace no token e lista de workspaces aceitos, separados por vírgula (vazio: qualquer workspace do emissor).
# OIDC_WORKSPACE_CLAIM=workspace_id
# OIDC_ALLOWED_WORKSPACES=
# Claim de papéis (aceita caminho com pontos, como realm_access.roles) e os nomes dos papéis administrador e operador.
# OIDC_ROLES_CLAIM=roles
# OIDC_ADMIN_ROLE=admin
# OIDC_OPERATOR_ROLE=operator
# Tolerância de relógio (s, 0 a 300), validade do cache do JWKS (s) e intervalo mínimo (s) entre buscas forçadas por um kid desconhecido.
# OIDC_LEEWAY_SECONDS=30
# OIDC_JWKS_TTL_SECONDS=600
# OIDC_JWKS_MIN_REFRESH_SECONDS=30
# Retenção (dias) de conversas, mensagens, execuções e evidências, aplicada como índices TTL pelo comando apply_indexes (docs/operacao.md).
# Ausente (não deixe a variável vazia): mantém para sempre.
# HISTORY_RETENTION_DAYS=

# --- Execução, streaming e manutenção (adapters/inbound/http/run_settings.py) -------------------------------
# Limites por execução: profundidade de delegação, delegações, chamadas de ferramenta, tempo (s) e tokens de saída (orçamento da execução).
# RUN_MAX_DEPTH=3
# RUN_MAX_DELEGATIONS=8
# RUN_MAX_TOOL_CALLS=12
# RUN_TIMEOUT_SECONDS=120
# RUN_MAX_OUTPUT_TOKENS=16000
# Execuções ativas (queued/running) por workspace; acima disso a API responde 429 capacity_exceeded.
# MAX_ACTIVE_RUNS=20
# Quanto POST /chat espera (s) antes de responder 202 com os ids da execução.
# CHAT_WAIT_SECONDS=90
# Espera (s) pelo encerramento da tarefa local após POST /runs/{id}/cancel.
# CANCEL_WAIT_SECONDS=2
# Lease da execução (s), intervalo do heartbeat (s; também a latência do cancelamento entre instâncias) e da varredura de leases expirados (s).
# RUN_LEASE_SECONDS=30
# RUN_HEARTBEAT_SECONDS=3
# MAINTENANCE_INTERVAL_SECONDS=10
# SSE: intervalo do comentário de heartbeat (s) e do polling dos eventos no banco (s).
# SSE_HEARTBEAT_SECONDS=15
# SSE_POLL_SECONDS=0.5
# Retenção dos eventos de execução (dias); define o TTL do índice de run_events. Cursor mais antigo recebe 410.
# EVENT_RETENTION_DAYS=7

# --- Base de conhecimento (adapters/inbound/knowledge_wiring.py; todas com prefixo KNOWLEDGE_) --------------
# Diretório com getnet/ (base curada e manifest.json) e sources.json (URLs oficiais e allowlist). No Compose: /data/knowledge (montado do host).
# KNOWLEDGE_DATA_DIR=../data/knowledge
# Chunking por seção: tamanho máximo e sobreposição em caracteres (a sobreposição deve ser menor que metade do máximo).
# KNOWLEDGE_CHUNK_MAX_CHARS=1200
# KNOWLEDGE_CHUNK_OVERLAP=150
# Coleta das páginas oficiais: bytes máximos, timeout (s) e redirecionamentos máximos.
# KNOWLEDGE_FETCH_MAX_BYTES=2000000
# KNOWLEDGE_FETCH_TIMEOUT_S=15.0
# KNOWLEDGE_FETCH_MAX_REDIRECTS=3
# Dimensão do vetor; obrigatória só para modelos de embedding fora da tabela embutida (text-embedding-3-small/large e ada-002).
# KNOWLEDGE_EMBEDDING_DIMENSIONS=
# Fila de ingestão no Mongo: lease (s), timeout por tentativa (s), tentativas, atraso base entre tentativas (s) e polling do worker (s).
# KNOWLEDGE_JOB_LEASE_S=60.0
# KNOWLEDGE_JOB_TIMEOUT_S=600.0
# KNOWLEDGE_JOB_MAX_ATTEMPTS=3
# KNOWLEDGE_JOB_RETRY_DELAY_S=30.0
# KNOWLEDGE_WORKER_POLL_S=2.0

# --- Fora do app (variáveis do shell, não do .env) --------------------------------------------------------------
# infra/mongo/backup.sh e restore.sh: MONGO_DATABASE (acima), BACKUP_DIR (padrão backups) e TARGET_DB (padrão <banco>_restore_check).
# frontend (npm run dev, variáveis do shell): VITE_API_TARGET aponta o proxy /api do Vite (padrão http://localhost:8000);
# VITE_TIMEZONE (padrão America/Sao_Paulo), VITE_DEMO_USER_ID (padrão cliente1988) e VITE_GRAFANA_URL (padrão http://localhost:3000).
# As VITE_* são lidas na compilação: no serviço frontend do Compose valem os padrões.
